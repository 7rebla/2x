#: twox/assets/apps.py:9
msgid "Structure"
msgstr "Struktur"

#: twox/assets/csv_import.py:242
#, python-format
msgid "The line is longer than %(limit)d bytes."
msgstr "Die Zeile ist länger als %(limit)d Byte."

#: twox/assets/csv_import.py:256
#, python-format
msgid ""
"The file is not UTF-8 (byte %(position)d of this line). Save it as UTF-8 and "
"try again."
msgstr ""
"Die Datei ist nicht in UTF-8 kodiert (Byte %(position)d dieser Zeile). "
"Speichern Sie sie als UTF-8 und versuchen Sie es erneut."

#: twox/assets/csv_import.py:274
#, python-format
msgid ""
"The first line must name exactly these %(count)d columns in this order: "
"%(columns)s."
msgstr ""
"Die erste Zeile muss genau diese %(count)d Spalten in dieser Reihenfolge "
"nennen: %(columns)s."

#: twox/assets/csv_import.py:279
#, python-format
msgid "Missing: %(columns)s."
msgstr "Es fehlen: %(columns)s."

#: twox/assets/csv_import.py:281
#, python-format
msgid "Not expected: %(columns)s."
msgstr "Nicht erwartet: %(columns)s."

#: twox/assets/csv_import.py:283
msgid "The separator must be a comma, not a semicolon."
msgstr "Das Trennzeichen muss ein Komma sein, kein Semikolon."

#: twox/assets/csv_import.py:289
#, python-format
msgid "A field in this row is longer than %(limit)d characters."
msgstr "Ein Feld in dieser Zeile ist länger als %(limit)d Zeichen."

#: twox/assets/csv_import.py:293
#, python-format
msgid "The row is not valid CSV: %(reason)s."
msgstr "Die Zeile ist kein gültiges CSV: %(reason)s."

#: twox/assets/csv_import.py:294
msgid "The rest of the file was not checked."
msgstr "Der Rest der Datei wurde nicht geprüft."

#: twox/assets/csv_import.py:324
msgid "A row with a device_id needs a device_name."
msgstr "Eine Zeile mit device_id braucht einen device_name."

#: twox/assets/csv_import.py:330
msgid ""
"This column describes a device; leave it empty in a row without device_id."
msgstr ""
"Diese Spalte beschreibt ein Gerät; lassen Sie sie in einer Zeile ohne "
"device_id leer."

#: twox/assets/csv_import.py:356
#, python-format
msgid "The row has %(found)d fields instead of %(expected)d."
msgstr "Die Zeile hat %(found)d Felder statt %(expected)d."

#: twox/assets/csv_import.py:399
#, python-format
msgid "Line %(line)d gives the plant %(key)s another value in this column."
msgstr ""
"Zeile %(line)d gibt der Anlage %(key)s in dieser Spalte einen anderen Wert."

#: twox/assets/csv_import.py:411
#, python-format
msgid "The device %(key)s appears in line %(line)d already."
msgstr "Das Gerät %(key)s steht schon in Zeile %(line)d."

#: twox/assets/csv_import.py:434
#, python-format
msgid "Line %(line)d gives the plant %(key)s other notes."
msgstr "Zeile %(line)d gibt der Anlage %(key)s andere Notizen."

#: twox/assets/csv_import.py:456
msgid "The file is empty."
msgstr "Die Datei ist leer."

#: twox/assets/csv_import.py:474
#, python-format
msgid "The file has more than %(limit)d rows."
msgstr "Die Datei hat mehr als %(limit)d Zeilen."

#: twox/assets/csv_import.py:484
#, python-format
msgid "More than %(limit)d errors; reading stopped at line %(line)d."
msgstr "Mehr als %(limit)d Fehler; das Lesen endete in Zeile %(line)d."

#: twox/assets/csv_import.py:604
msgid "Another change was saved at the same time; run the import again."
msgstr ""
"Gleichzeitig wurde eine andere Änderung gespeichert; starten Sie den Import "
"erneut."

#: twox/assets/csv_import.py:607
msgid "The database refused this row."
msgstr "Die Datenbank hat diese Zeile abgelehnt."

#: twox/assets/integrity.py:18
