# Copy to .env (never committed). Development values only, no real secrets.

TWOX_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
TWOX_DEBUG=true
# Keep localhost in the list: the health check of the api container uses it.
TWOX_ALLOWED_HOSTS=localhost,127.0.0.1

# Host port of the API, published on 127.0.0.1 only.
TWOX_API_PORT=8000

TWOX_DB_HOST=db
TWOX_DB_PORT=5432
TWOX_DB_NAME=twox
TWOX_DB_USER=twox
TWOX_DB_PASSWORD=dev-only-db-password

# Valkey as Celery broker and result store. Celery reaches it through its
# Redis transport, hence redis:// (there is no valkey:// scheme).
TWOX_CELERY_BROKER_URL=redis://valkey:6379/0
TWOX_CELERY_RESULT_BACKEND=redis://valkey:6379/1
# Django cache shared by all API processes (e.g. the login rate limit), in its
# own Valkey database next to broker (0) and results (1).
TWOX_CACHE_URL=redis://valkey:6379/2

# Ollama runs on the host; containers reach it via host.docker.internal.
TWOX_LLM_BASE_URL=http://host.docker.internal:11434/v1
TWOX_DOCLING_URL=http://docling:5001

# Optional AI features (E-59): embeddings and vector search, later answers
# with a language model. They need Ollama (or another OpenAI-compatible model
# server) with the models below and suitable hardware. Unset or false (the
# default without this file): the model service is never contacted, and
# structure, files, import, ingestion and keyword search work as usual. This
# development template switches them on.
TWOX_AI_ENABLED=true
# Embedding model in Ollama (E-56) and its vector length; the length must match
# the vector column of the database. Load the model with: ollama pull bge-m3
TWOX_EMBED_MODEL=bge-m3
TWOX_EMBED_DIMENSIONS=1024
# Texts per request, and the time limit of one request in seconds.
TWOX_EMBED_BATCH_SIZE=16
TWOX_EMBED_TIMEOUT_SECONDS=120
# Put in front of search queries only; empty for bge-m3.
TWOX_EMBED_QUERY_PREFIX=

# Uploaded files are stored below this directory inside the api and worker
# containers. Compose mounts the volume media-data exactly there, so keep the
# default unless you change that mount as well. Must be an absolute path.
TWOX_MEDIA_ROOT=/data/media
# Largest accepted upload in bytes (decimal: 200000000 = 200 MB).
TWOX_UPLOAD_MAX_BYTES=200000000

# Test account of the browser test (Playwright, service e2e). Development
# values only: the CI creates the account with these values in its throwaway
# database (README, "Browser test"). Never use them for a real account.
TWOX_E2E_USERNAME=e2e-manager
TWOX_E2E_PASSWORD=dev-only-e2e-password
